# =============================================================================
# GasPredict Ecuador — Imagen todo-en-uno
# PostgreSQL + FastAPI (Python 3.11) + Next.js en un solo contenedor
#
# Build:  docker build -f Dockerfile.all-in-one -t gaspredict:latest .
# Run:    docker run -d -p 3001:3001 -p 8001:8001 --name gaspredict gaspredict:latest
# Logs:   docker logs -f gaspredict
# Stop:   docker stop gaspredict
# =============================================================================

# ── Stage 1: Build del Frontend ───────────────────────────────────────────────
FROM node:20-slim AS frontend-builder

WORKDIR /frontend

ENV NODE_TLS_REJECT_UNAUTHORIZED=0 \
    NPM_CONFIG_STRICT_SSL=false \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=http://localhost:8001

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY frontend/ .
RUN npm run build

# ── Stage 2: Imagen final todo-en-uno ─────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    PORT=3001 \
    HOSTNAME=0.0.0.0 \
    POSTGRES_USER=gaspredict \
    POSTGRES_PASSWORD=gaspredict2026 \
    POSTGRES_DB=gaspredict \
    DATABASE_URL=postgresql://gaspredict:gaspredict2026@localhost:5432/gaspredict

# ── Dependencias del sistema ──────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        postgresql \
        postgresql-client \
        gcc g++ libpq-dev curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Backend Python ────────────────────────────────────────────────────────────
WORKDIR /app/backend

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --timeout=300 numpy==1.26.4 pandas==2.2.3
RUN pip install --no-cache-dir --timeout=300 tensorflow==2.18.0
RUN pip install --no-cache-dir --timeout=300 -r requirements.txt
RUN python -c "import nltk; nltk.download('vader_lexicon', quiet=True); nltk.download('punkt', quiet=True)" || true

COPY backend/ .

# ── Frontend Next.js ──────────────────────────────────────────────────────────
WORKDIR /app/frontend

COPY --from=frontend-builder /frontend/public ./public
COPY --from=frontend-builder /frontend/.next/standalone ./
COPY --from=frontend-builder /frontend/.next/static ./.next/static

# ── Scripts y datos de inicialización ─────────────────────────────────────────
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/gaspredict_backup.sql /docker/gaspredict_backup.sql
RUN chmod +x /entrypoint.sh

# ── Puertos ───────────────────────────────────────────────────────────────────
EXPOSE 3001 8001

ENTRYPOINT ["/entrypoint.sh"]
